<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:ShApp.Mobile.ViewModels"
             xmlns:items="clr-namespace:ShApp.Mobile.ViewModels.Items"
             x:Class="ShApp.Mobile.Views.DashboardPage"
             x:DataType="vm:DashboardViewModel"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{StaticResource ObBackground}">

    <Grid RowDefinitions="Auto,*">

        <!-- ===================== HEADER ===================== -->
        <Grid Grid.Row="0"
              Padding="20,14"
              ColumnDefinitions="*,Auto"
              BackgroundColor="{StaticResource ObBackground}">

            <HorizontalStackLayout Grid.Column="0" Spacing="10" VerticalOptions="Center">
                <Border WidthRequest="28" HeightRequest="28"
                        Background="{StaticResource ObSurfaceElevated}"
                        Stroke="{StaticResource ObBorderBrush}"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 8"
                        Padding="0">
                    <Label Text="&#xeb43;" Style="{StaticResource ObIcon}"
                           FontSize="15" TextColor="{StaticResource ObPrimary}"
                           HorizontalOptions="Center" VerticalOptions="Center" />
                </Border>
                <Label Text="SHAPP" FontFamily="GeistSemiBold" FontSize="15"
                       CharacterSpacing="1.5" TextColor="{StaticResource ObOnSurface}"
                       VerticalOptions="Center" />
            </HorizontalStackLayout>

            <HorizontalStackLayout Grid.Column="1" Spacing="8" VerticalOptions="Center">
                <Border Style="{StaticResource ObPill}">
                    <HorizontalStackLayout Spacing="5" VerticalOptions="Center">
                        <Ellipse WidthRequest="6" HeightRequest="6" Fill="{StaticResource ObOnSurfaceSubtle}" VerticalOptions="Center" />
                        <Label Text="OFFLINE" Style="{StaticResource ObMono}" FontSize="10" />
                    </HorizontalStackLayout>
                </Border>
                <Border WidthRequest="30" HeightRequest="30"
                        Background="{StaticResource ObSurfaceElevated}"
                        Stroke="{StaticResource ObBorderBrush}"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 15"
                        Padding="0">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnPerfilIconTapped" />
                    </Border.GestureRecognizers>
                    <Label Text="&#xf0d3;" Style="{StaticResource ObIcon}" FontSize="15"
                           HorizontalOptions="Center" VerticalOptions="Center" />
                </Border>
            </HorizontalStackLayout>
        </Grid>

        <!-- ===================== EMPTY STATE ===================== -->
        <VerticalStackLayout Grid.Row="1" IsVisible="{Binding IsEmptyState}"
                              VerticalOptions="Center" HorizontalOptions="Center" Spacing="10" Padding="30">
            <Label Text="&#xeb43;" FontFamily="MaterialSymbolsOutlined" FontSize="36"
                   TextColor="{StaticResource ObOnSurfaceSubtle}" HorizontalOptions="Center" />
            <Label Text="{Binding EmptyStateMessage}" Style="{StaticResource ObTitleMd}" HorizontalOptions="Center"
                   HorizontalTextAlignment="Center" />
            <Label Text="Crie uma rotina para começar a treinar." Style="{StaticResource ObLabelMuted}"
                   HorizontalOptions="Center" HorizontalTextAlignment="Center" />
        </VerticalStackLayout>

        <!-- ===================== CONTENT ===================== -->
        <ScrollView Grid.Row="1" IsVisible="{Binding HasRotina}">
            <VerticalStackLayout Padding="16,6,16,28" Spacing="18">

                <!-- 1. SAUDAÇÃO & STREAK -->
                <Grid ColumnDefinitions="*,Auto">
                    <VerticalStackLayout Grid.Column="0" Spacing="3" VerticalOptions="Center">
                        <Label Text="{Binding CicloLabel}" Style="{StaticResource ObEyebrow}" />
                        <Label Text="Treino do Dia" Style="{StaticResource ObTitleMd}" />
                    </VerticalStackLayout>
                    <Border Grid.Column="1" Style="{StaticResource ObPill}" VerticalOptions="Center">
                        <HorizontalStackLayout Spacing="5">
                            <Label Text="&#xef55;" Style="{StaticResource ObIcon}" FontSize="14" TextColor="{StaticResource ObPrimary}" />
                            <Label Text="{Binding StreakLabel}" Style="{StaticResource ObMono}" FontSize="12" TextColor="{StaticResource ObOnSurface}" />
                        </HorizontalStackLayout>
                    </Border>
                </Grid>

                <!-- 2. CARD TREINO DE HOJE -->
                <Border Style="{StaticResource ObCard}">
                    <VerticalStackLayout Spacing="14">

                        <Grid ColumnDefinitions="*,Auto" Padding="0,0,0,12">
                            <HorizontalStackLayout Grid.Column="0" Spacing="8">
                                <Border WidthRequest="24" HeightRequest="24"
                                        Background="{StaticResource ObPrimarySoft}"
                                        Stroke="{StaticResource ObPrimaryBrush}" StrokeThickness="1"
                                        StrokeShape="RoundRectangle 6" Padding="0">
                                    <Label Text="{Binding TreinoHojeBadge}" FontFamily="JetBrainsMonoSemiBold" FontSize="12"
                                           TextColor="{StaticResource ObPrimary}"
                                           HorizontalOptions="Center" VerticalOptions="Center" />
                                </Border>
                                <Label Text="HOJE" Style="{StaticResource ObEyebrow}" VerticalOptions="Center" />
                            </HorizontalStackLayout>
                            <Label Grid.Column="1" Text="{Binding SessaoLabel}" Style="{StaticResource ObMono}"
                                   FontSize="11" VerticalOptions="Center" />
                        </Grid>
                        <BoxView HeightRequest="1" Color="{StaticResource ObBorder}" Opacity="0.6" />

                        <VerticalStackLayout Spacing="4">
                            <Label Text="{Binding TreinoHojeTitulo}" Style="{StaticResource ObTitleLg}" />
                            <Label Text="{Binding TreinoHojeSubtitulo}"
                                   Style="{StaticResource ObLabelMuted}" FontSize="13" />
                        </VerticalStackLayout>

                        <Border Background="{StaticResource ObSurfaceSunken}"
                                Stroke="{StaticResource ObBorderSubtle}" StrokeThickness="1"
                                StrokeShape="RoundRectangle 12" Padding="14,10">
                            <Grid ColumnDefinitions="*,*,*">
                                <VerticalStackLayout Grid.Column="0" Spacing="2">
                                    <Label Text="Exercícios" Style="{StaticResource ObLabelSubtle}" />
                                    <Label Text="{Binding ExerciciosCountLabel}" FontFamily="JetBrainsMonoSemiBold" FontSize="14" />
                                </VerticalStackLayout>
                                <VerticalStackLayout Grid.Column="1" Spacing="2">
                                    <Label Text="Volume" Style="{StaticResource ObLabelSubtle}" />
                                    <Label Text="{Binding VolumeLabel}" FontFamily="JetBrainsMonoSemiBold" FontSize="14" />
                                </VerticalStackLayout>
                                <VerticalStackLayout Grid.Column="2" Spacing="2">
                                    <Label Text="Tempo est." Style="{StaticResource ObLabelSubtle}" />
                                    <Label Text="{Binding TempoEstimadoLabel}" FontFamily="JetBrainsMonoSemiBold" FontSize="14" />
                                </VerticalStackLayout>
                            </Grid>
                        </Border>

                        <VerticalStackLayout Spacing="10" IsVisible="{Binding TreinoHojeDisponivel}">
                            <Button Text="&#9654;  Iniciar Treino" Style="{StaticResource ObPrimaryButton}"
                                    Clicked="OnStartWorkoutClicked" />

                            <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                                <Button Grid.Column="0" Text="&#9776;  Exercícios" Style="{StaticResource ObSecondaryButton}" />
                                <Button Grid.Column="1" Text="&#8645;  Reordenar" Style="{StaticResource ObSecondaryButton}" />
                            </Grid>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>

                <!-- 3. FREQUÊNCIA -->
                <Border Style="{StaticResource ObCard}" Padding="16,14">
                    <VerticalStackLayout Spacing="10">

                        <Grid ColumnDefinitions="*,Auto" Padding="0,0,0,10">
                            <HorizontalStackLayout Grid.Column="0" Spacing="6" VerticalOptions="Center">
                                <Label Text="Frequência" FontFamily="GeistSemiBold" FontSize="13" />
                                <Label Text="{Binding TotalTreinosLabel}" Style="{StaticResource ObMono}" FontSize="11" />
                            </HorizontalStackLayout>
                            <HorizontalStackLayout Grid.Column="1" Spacing="4" VerticalOptions="Center">
                                <Label Text="&#xe5cb;" Style="{StaticResource ObIcon}" FontSize="15" />
                                <Label Text="{Binding PeriodoLabel}" Style="{StaticResource ObMono}" FontSize="12" TextColor="{StaticResource ObOnSurfaceMuted}" />
                                <Label Text="&#xe5cc;" Style="{StaticResource ObIcon}" FontSize="15" />
                            </HorizontalStackLayout>
                        </Grid>
                        <BoxView HeightRequest="1" Color="{StaticResource ObBorder}" Opacity="0.5" />

                        <HorizontalStackLayout Spacing="10">
                            <Grid x:Name="DayLabelsGrid" RowDefinitions="14,14,14,14,14,14,14" />
                            <Grid x:Name="HeatmapGrid" ColumnSpacing="3" RowSpacing="3"
                                  HorizontalOptions="Start" />
                        </HorizontalStackLayout>

                        <BoxView HeightRequest="1" Color="{StaticResource ObBorder}" Opacity="0.5" Margin="0,4,0,0" />
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Grid.Column="0" Text="{Binding ConstanciaLabel}" Style="{StaticResource ObMono}"
                                   FontSize="11" TextColor="{StaticResource ObOnSurfaceMuted}" VerticalOptions="Center" />
                            <HorizontalStackLayout Grid.Column="1" Spacing="4" VerticalOptions="Center">
                                <Label Text="Menos" Style="{StaticResource ObLabelSubtle}" FontSize="10" />
                                <BoxView WidthRequest="8" HeightRequest="8" CornerRadius="2" Color="{StaticResource ObHeat0}" />
                                <BoxView WidthRequest="8" HeightRequest="8" CornerRadius="2" Color="{StaticResource ObHeat1}" />
                                <BoxView WidthRequest="8" HeightRequest="8" CornerRadius="2" Color="{StaticResource ObHeat2}" />
                                <BoxView WidthRequest="8" HeightRequest="8" CornerRadius="2" Color="{StaticResource ObHeat3}" />
                                <BoxView WidthRequest="8" HeightRequest="8" CornerRadius="2" Color="{StaticResource ObHeat4}" />
                                <Label Text="Mais" Style="{StaticResource ObLabelSubtle}" FontSize="10" />
                            </HorizontalStackLayout>
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <!-- 4. SEQUÊNCIA CONTÍNUA -->
                <VerticalStackLayout Spacing="8">
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Grid.Column="0" Text="SEQUÊNCIA CONTÍNUA" Style="{StaticResource ObEyebrow}" />
                        <Label Grid.Column="1" Text="Fluxo Livre" Style="{StaticResource ObMono}" FontSize="11" />
                    </Grid>

                    <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8"
                          BindableLayout.ItemsSource="{Binding SequenciaDias}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="items:SequenciaDiaViewModel">
                                <Border Grid.Column="{Binding ColumnIndex}"
                                        Background="{StaticResource ObSurfaceCardBrush}"
                                        StrokeShape="RoundRectangle 12" Padding="12">
                                    <Border.Triggers>
                                        <DataTrigger TargetType="Border" Binding="{Binding IsHoje}" Value="True">
                                            <Setter Property="Stroke" Value="{StaticResource ObPrimaryBrush}" />
                                            <Setter Property="StrokeThickness" Value="1" />
                                            <Setter Property="Opacity" Value="1" />
                                        </DataTrigger>
                                        <DataTrigger TargetType="Border" Binding="{Binding IsProximo}" Value="True">
                                            <Setter Property="Stroke" Value="{StaticResource ObBorderBrush}" />
                                            <Setter Property="StrokeThickness" Value="1" />
                                            <Setter Property="Opacity" Value="0.75" />
                                        </DataTrigger>
                                        <DataTrigger TargetType="Border" Binding="{Binding IsASeguir}" Value="True">
                                            <Setter Property="Stroke" Value="{StaticResource ObBorderBrush}" />
                                            <Setter Property="StrokeThickness" Value="1" />
                                            <Setter Property="Opacity" Value="0.55" />
                                        </DataTrigger>
                                    </Border.Triggers>
                                    <VerticalStackLayout Spacing="2">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <Label Grid.Column="0" Text="{Binding EstadoLabel}" FontFamily="JetBrainsMonoMedium" FontSize="10"
                                                   TextColor="{StaticResource ObOnSurfaceSubtle}">
                                                <Label.Triggers>
                                                    <DataTrigger TargetType="Label" Binding="{Binding IsHoje}" Value="True">
                                                        <Setter Property="TextColor" Value="{StaticResource ObPrimary}" />
                                                    </DataTrigger>
                                                </Label.Triggers>
                                            </Label>
                                            <Ellipse Grid.Column="1" WidthRequest="6" HeightRequest="6"
                                                     Fill="{StaticResource ObPrimaryBrush}" VerticalOptions="Center"
                                                     IsVisible="{Binding IsHoje}" />
                                        </Grid>
                                        <Label Text="{Binding Letra}" FontFamily="JetBrainsMonoSemiBold" FontSize="16" Margin="0,4,0,0"
                                               TextColor="{StaticResource ObOnSurfaceMuted}">
                                            <Label.Triggers>
                                                <DataTrigger TargetType="Label" Binding="{Binding IsHoje}" Value="True">
                                                    <Setter Property="TextColor" Value="{StaticResource ObOnSurface}" />
                                                </DataTrigger>
                                            </Label.Triggers>
                                        </Label>
                                        <Label Text="{Binding NomeGrupo}" FontSize="11" TextColor="{StaticResource ObOnSurfaceMuted}" />
                                        <Label Text="{Binding RelativoLabel}" Style="{StaticResource ObLabelSubtle}" FontSize="10" Margin="0,6,0,0" />
                                    </VerticalStackLayout>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </Grid>
                </VerticalStackLayout>

                <!-- 5. MINI STATS -->
                <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                    <Border Grid.Column="0" Style="{StaticResource ObCard}" Padding="14">
                        <VerticalStackLayout Spacing="2">
                            <Grid ColumnDefinitions="*,Auto">
                                <Label Grid.Column="0" Text="RECORDE RECENTE" FontFamily="JetBrainsMonoMedium"
                                       FontSize="10" TextColor="{StaticResource ObOnSurfaceSubtle}" />
                                <Label Grid.Column="1" Text="&#xea3f;" Style="{StaticResource ObIcon}" FontSize="14" />
                            </Grid>
                            <HorizontalStackLayout Spacing="3" Margin="0,8,0,2">
                                <Label Text="{Binding RecordeValorLabel}" FontFamily="JetBrainsMonoSemiBold" FontSize="20" />
                            </HorizontalStackLayout>
                            <Label Text="{Binding RecordeExercicioLabel}" FontSize="11" TextColor="{StaticResource ObOnSurfaceMuted}" />
                            <Label Text="{Binding RecordeDeltaLabel}" FontFamily="JetBrainsMonoRegular" FontSize="10"
                                   TextColor="{StaticResource ObPrimary}" Margin="0,4,0,0" />
                        </VerticalStackLayout>
                    </Border>

                    <Border Grid.Column="1" Style="{StaticResource ObCard}" Padding="14">
                        <VerticalStackLayout Spacing="2">
                            <Grid ColumnDefinitions="*,Auto">
                                <Label Grid.Column="0" Text="VOLUME TOTAL" FontFamily="JetBrainsMonoMedium"
                                       FontSize="10" TextColor="{StaticResource ObOnSurfaceSubtle}" />
                                <Label Grid.Column="1" Text="&#xeb43;" Style="{StaticResource ObIcon}" FontSize="14" />
                            </Grid>
                            <HorizontalStackLayout Spacing="3" Margin="0,8,0,2">
                                <Label Text="{Binding VolumeTotalValorLabel}" FontFamily="JetBrainsMonoSemiBold" FontSize="20" />
                            </HorizontalStackLayout>
                            <Label Text="{Binding VolumeTotalDetalheLabel}" FontSize="11" TextColor="{StaticResource ObOnSurfaceMuted}" />
                            <Label Text="{Binding VolumeTotalMediaLabel}" FontFamily="JetBrainsMonoRegular" FontSize="10"
                                   TextColor="{StaticResource ObOnSurfaceSubtle}" Margin="0,4,0,0" />
                        </VerticalStackLayout>
                    </Border>
                </Grid>

            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
