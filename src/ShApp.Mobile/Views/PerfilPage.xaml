<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:ShApp.Mobile.ViewModels"
             x:Class="ShApp.Mobile.Views.PerfilPage"
             x:DataType="vm:PerfilViewModel"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{StaticResource ObBackground}">

    <Grid RowDefinitions="Auto,*">

        <!-- ===================== HEADER ===================== -->
        <Grid Grid.Row="0"
              Padding="20,14"
              ColumnDefinitions="*,Auto"
              BackgroundColor="{StaticResource ObBackground}">

            <HorizontalStackLayout Grid.Column="0" Spacing="10" VerticalOptions="Center">
                <Border WidthRequest="28" HeightRequest="28"
                        Background="{StaticResource ObSurfaceElevated}"
                        Stroke="{StaticResource ObBorderBrush}"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 8"
                        Padding="0">
                    <Label Text="&#xeb43;" Style="{StaticResource ObIcon}"
                           FontSize="15" TextColor="{StaticResource ObPrimary}"
                           HorizontalOptions="Center" VerticalOptions="Center" />
                </Border>
                <Label Text="SHAPP" FontFamily="GeistSemiBold" FontSize="15"
                       CharacterSpacing="1.5" TextColor="{StaticResource ObOnSurface}"
                       VerticalOptions="Center" />
                <Label Text="Perfil" Style="{StaticResource ObTitleMd}" FontSize="17"
                       VerticalOptions="Center" Margin="4,0,0,0" />
            </HorizontalStackLayout>

            <Border Grid.Column="1" WidthRequest="32" HeightRequest="32"
                    Background="{StaticResource ObPrimaryBrush}"
                    StrokeThickness="0"
                    StrokeShape="RoundRectangle 16"
                    Padding="0" VerticalOptions="Center">
                <Label Text="&#xf0d3;" FontFamily="MaterialSymbolsOutlined" FontSize="16"
                       TextColor="{StaticResource ObOnPrimary}"
                       HorizontalOptions="Center" VerticalOptions="Center" />
            </Border>
        </Grid>

        <!-- ===================== CONTENT ===================== -->
        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="16,6,16,28" Spacing="18">

                <!-- 1. HERO DE PERFIL -->
                <Border Style="{StaticResource ObCard}" Padding="18">
                    <VerticalStackLayout Spacing="14">
                        <Grid ColumnDefinitions="Auto,*">

                            <!-- Avatar com selo "Local" -->
                            <Grid Grid.Column="0" WidthRequest="76" HeightRequest="76" Margin="0,0,14,0">
                                <Border WidthRequest="76" HeightRequest="76"
                                        Background="{StaticResource ObSurfaceElevated}"
                                        Stroke="{StaticResource ObPrimaryBrush}" StrokeThickness="1.5"
                                        StrokeShape="RoundRectangle 38" Padding="0">
                                    <Label Text="{Binding Inicial}" FontFamily="GeistSemiBold" FontSize="28"
                                           TextColor="{StaticResource ObPrimary}"
                                           HorizontalOptions="Center" VerticalOptions="Center" />
                                </Border>
                                <Border HorizontalOptions="End" VerticalOptions="End" Margin="0,0,-4,-4"
                                        Background="{StaticResource ObSurfaceCardBrush}"
                                        Stroke="{StaticResource ObBackgroundBrush}" StrokeThickness="2"
                                        StrokeShape="RoundRectangle 10" Padding="6,2">
                                    <HorizontalStackLayout Spacing="4" VerticalOptions="Center">
                                        <Ellipse WidthRequest="6" HeightRequest="6" Fill="{StaticResource ObTertiary}" VerticalOptions="Center" />
                                        <Label Text="Local" FontFamily="GeistMedium" FontSize="9"
                                               TextColor="{StaticResource ObTertiary}" VerticalOptions="Center" />
                                    </HorizontalStackLayout>
                                </Border>
                            </Grid>

                            <!-- Nome e detalhes -->
                            <VerticalStackLayout Grid.Column="1" Spacing="3" VerticalOptions="Center">
                                <Label Text="{Binding NomeUsuario}" Style="{StaticResource ObTitleMd}" FontSize="18"
                                       LineBreakMode="TailTruncation" />
                                <Label Text="{Binding SubtituloLabel}" Style="{StaticResource ObLabelMuted}" FontSize="12"
                                       LineBreakMode="TailTruncation" />
                                <HorizontalStackLayout Spacing="6" Margin="0,4,0,0">
                                    <Border Background="{StaticResource ObSurfaceElevated}" StrokeShape="RoundRectangle 5"
                                            StrokeThickness="0" Padding="7,3">
                                        <Label Text="{Binding MembroDesdeLabel}" FontFamily="GeistMedium" FontSize="10"
                                               TextColor="{StaticResource ObOnSurfaceMuted}" />
                                    </Border>
                                    <Border Background="{StaticResource ObPrimarySoft}" StrokeShape="RoundRectangle 5"
                                            StrokeThickness="0" Padding="7,3">
                                        <Label Text="Plano Free Local" FontFamily="GeistMedium" FontSize="10"
                                               TextColor="{StaticResource ObPrimary}" />
                                    </Border>
                                </HorizontalStackLayout>
                            </VerticalStackLayout>
                        </Grid>

                        <Button Text="&#9999;  Editar Perfil" Style="{StaticResource ObSecondaryButton}"
                                HeightRequest="42" FontSize="13" />
                    </VerticalStackLayout>
                </Border>

                <!-- 2. RESUMO DE PERFORMANCE -->
                <VerticalStackLayout Spacing="8">
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Grid.Column="0" Text="RESUMO DE PERFORMANCE" Style="{StaticResource ObEyebrow}" VerticalOptions="Center" />
                        <HorizontalStackLayout Grid.Column="1" Spacing="4" VerticalOptions="Center">
                            <Ellipse WidthRequest="5" HeightRequest="5" Fill="{StaticResource ObTertiary}" VerticalOptions="Center" />
                            <Label Text="Sincronizado c/ SQLite" FontFamily="JetBrainsMonoRegular" FontSize="10"
                                   TextColor="{StaticResource ObTertiary}" />
                        </HorizontalStackLayout>
                    </Grid>

                    <Grid ColumnDefinitions="*,*" ColumnSpacing="10" RowDefinitions="Auto,Auto" RowSpacing="10">
                        <!-- Sessões Concluídas -->
                        <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource ObCard}" Padding="14">
                            <VerticalStackLayout Spacing="2">
                                <Grid ColumnDefinitions="*,Auto">
                                    <Label Grid.Column="0" Text="Sessões Concluídas" Style="{StaticResource ObLabelSubtle}" FontSize="11" VerticalOptions="Center" />
                                    <Label Grid.Column="1" Text="&#xeb43;" Style="{StaticResource ObIcon}" FontSize="14" TextColor="{StaticResource ObPrimary}" />
                                </Grid>
                                <Label Text="{Binding SessoesConcluidasLabel}" FontFamily="JetBrainsMonoSemiBold" FontSize="20" Margin="0,6,0,0" />
                                <Label Text="{Binding SessoesConcluidasDeltaLabel}" FontFamily="GeistRegular" FontSize="10"
                                       TextColor="{StaticResource ObTertiary}" Margin="0,2,0,0" />
                            </VerticalStackLayout>
                        </Border>

                        <!-- Carga Total -->
                        <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource ObCard}" Padding="14">
                            <VerticalStackLayout Spacing="2">
                                <Grid ColumnDefinitions="*,Auto">
                                    <Label Grid.Column="0" Text="Carga Total (Volume)" Style="{StaticResource ObLabelSubtle}" FontSize="11" VerticalOptions="Center" />
                                    <Label Grid.Column="1" Text="&#xe13d;" Style="{StaticResource ObIcon}" FontSize="14" TextColor="{StaticResource ObPrimary}" />
                                </Grid>
                                <Label Text="{Binding CargaTotalLabel}" FontFamily="JetBrainsMonoSemiBold" FontSize="20" Margin="0,6,0,0" />
                                <Label Text="{Binding CargaTotalDeltaLabel}" FontFamily="GeistRegular" FontSize="10"
                                       TextColor="{StaticResource ObTertiary}" Margin="0,2,0,0" />
                            </VerticalStackLayout>
                        </Border>

                        <!-- Sequência Ativa -->
                        <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource ObCard}" Padding="14">
                            <VerticalStackLayout Spacing="2">
                                <Grid ColumnDefinitions="*,Auto">
                                    <Label Grid.Column="0" Text="Sequência Ativa" Style="{StaticResource ObLabelSubtle}" FontSize="11" VerticalOptions="Center" />
                                    <Label Grid.Column="1" Text="&#xef55;" Style="{StaticResource ObIcon}" FontSize="14" TextColor="{StaticResource ObPrimary}" />
                                </Grid>
                                <Label Text="{Binding SequenciaAtivaLabel}" FontFamily="JetBrainsMonoSemiBold" FontSize="20" Margin="0,6,0,0" />
                                <Label Text="{Binding SequenciaAtivaDeltaLabel}" Style="{StaticResource ObLabelSubtle}" FontSize="10" Margin="0,2,0,0" />
                            </VerticalStackLayout>
                        </Border>

                        <!-- Frequência Média -->
                        <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource ObCard}" Padding="14">
                            <VerticalStackLayout Spacing="2">
                                <Grid ColumnDefinitions="*,Auto">
                                    <Label Grid.Column="0" Text="Frequência Média" Style="{StaticResource ObLabelSubtle}" FontSize="11" VerticalOptions="Center" />
                                    <Label Grid.Column="1" Text="&#xe9e4;" Style="{StaticResource ObIcon}" FontSize="14" TextColor="{StaticResource ObPrimary}" />
                                </Grid>
                                <Label Text="{Binding FrequenciaMediaLabel}" FontFamily="JetBrainsMonoSemiBold" FontSize="20" Margin="0,6,0,0" />
                                <Label Text="{Binding FrequenciaMediaDeltaLabel}" Style="{StaticResource ObLabelSubtle}" FontSize="10" Margin="0,2,0,0" />
                            </VerticalStackLayout>
                        </Border>
                    </Grid>
                </VerticalStackLayout>

                <!-- 3. CICLO & ROTINA ATUAL -->
                <Border Style="{StaticResource ObCard}" Padding="16,14">
                    <VerticalStackLayout Spacing="10">
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Grid.Column="0" Text="CICLO &amp; ROTINA ATUAL" Style="{StaticResource ObEyebrow}" VerticalOptions="Center" />
                            <Border Grid.Column="1" Background="#3334D399"
                                    StrokeThickness="0" StrokeShape="RoundRectangle 20" Padding="8,3"
                                    IsVisible="{Binding HasRotina}">
                                <HorizontalStackLayout Spacing="4">
                                    <Ellipse WidthRequest="5" HeightRequest="5" Fill="{StaticResource ObTertiary}" VerticalOptions="Center" />
                                    <Label Text="Ativa no Momento" FontFamily="JetBrainsMonoMedium" FontSize="9"
                                           TextColor="{StaticResource ObTertiary}" />
                                </HorizontalStackLayout>
                            </Border>
                        </Grid>

                        <Border Background="{StaticResource ObSurfaceElevated}" Stroke="{StaticResource ObBorderSubtle}"
                                StrokeThickness="1" StrokeShape="RoundRectangle 12" Padding="14,12">
                            <VerticalStackLayout Spacing="10">
                                <Grid ColumnDefinitions="*,Auto">
                                    <VerticalStackLayout Grid.Column="0" Spacing="2">
                                        <Label Text="{Binding RotinaNomeLabel}" FontFamily="GeistSemiBold" FontSize="14" />
                                        <Label Text="{Binding RotinaResumoLabel}" Style="{StaticResource ObLabelMuted}" FontSize="11" />
                                    </VerticalStackLayout>
                                    <Label Grid.Column="1" Text="&#xe935;" FontFamily="MaterialSymbolsOutlined" FontSize="18"
                                           TextColor="{StaticResource ObPrimary}" VerticalOptions="Start" />
                                </Grid>

                                <BoxView HeightRequest="1" Color="{StaticResource ObBorder}" Opacity="0.5" IsVisible="{Binding ProximaSessaoDisponivel}" />

                                <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding ProximaSessaoDisponivel}">
                                    <HorizontalStackLayout Grid.Column="0" Spacing="5" VerticalOptions="Center">
                                        <Label Text="&#xe1c4;" FontFamily="MaterialSymbolsOutlined" FontSize="15"
                                               TextColor="{StaticResource ObTertiary}" VerticalOptions="Center" />
                                        <Label Text="Próxima sessão:" FontFamily="GeistRegular" FontSize="11"
                                               TextColor="{StaticResource ObOnSurfaceMuted}" VerticalOptions="Center" />
                                        <Label Text="{Binding ProximaSessaoLabel}" FontFamily="GeistMedium" FontSize="11"
                                               TextColor="{StaticResource ObOnSurface}" VerticalOptions="Center"
                                               LineBreakMode="TailTruncation" />
                                    </HorizontalStackLayout>
                                    <HorizontalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                        <HorizontalStackLayout.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding VerRotinaCommand}" />
                                        </HorizontalStackLayout.GestureRecognizers>
                                        <Label Text="Ver Rotina" FontFamily="GeistMedium" FontSize="11" TextColor="{StaticResource ObPrimary}" />
                                        <Label Text="&#xe5cc;" FontFamily="MaterialSymbolsOutlined" FontSize="13" TextColor="{StaticResource ObPrimary}" />
                                    </HorizontalStackLayout>
                                </Grid>
                            </VerticalStackLayout>
                        </Border>
                    </VerticalStackLayout>
                </Border>

                <!-- 4. BIOMETRIA & PARÂMETROS -->
                <Border Style="{StaticResource ObCard}" Padding="16,14">
                    <VerticalStackLayout Spacing="10">
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Grid.Column="0" Text="BIOMETRIA &amp; PARÂMETROS" Style="{StaticResource ObEyebrow}" VerticalOptions="Center" />
                            <HorizontalStackLayout Grid.Column="1" Spacing="3">
                                <Label Text="&#xe8b3;" FontFamily="MaterialSymbolsOutlined" FontSize="12" TextColor="{StaticResource ObPrimary}" />
                                <Label Text="Atualizar Medidas" FontFamily="GeistMedium" FontSize="11" TextColor="{StaticResource ObPrimary}" />
                            </HorizontalStackLayout>
                        </Grid>

                        <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
                            <Border Grid.Column="0" Background="{StaticResource ObSurfaceElevated}" StrokeThickness="0"
                                    StrokeShape="RoundRectangle 12" Padding="8,12">
                                <VerticalStackLayout Spacing="4" HorizontalOptions="Center">
                                    <Label Text="PESO ATUAL" FontFamily="JetBrainsMonoMedium" FontSize="9"
                                           TextColor="{StaticResource ObOnSurfaceSubtle}" HorizontalOptions="Center" />
                                    <Label Text="{Binding PesoAtualLabel}" FontFamily="JetBrainsMonoSemiBold" FontSize="15" HorizontalOptions="Center" />
                                </VerticalStackLayout>
                            </Border>
                            <Border Grid.Column="1" Background="{StaticResource ObSurfaceElevated}" StrokeThickness="0"
                                    StrokeShape="RoundRectangle 12" Padding="8,12">
                                <VerticalStackLayout Spacing="4" HorizontalOptions="Center">
                                    <Label Text="ALTURA" FontFamily="JetBrainsMonoMedium" FontSize="9"
                                           TextColor="{StaticResource ObOnSurfaceSubtle}" HorizontalOptions="Center" />
                                    <Label Text="{Binding AlturaLabel}" FontFamily="JetBrainsMonoSemiBold" FontSize="15" HorizontalOptions="Center" />
                                </VerticalStackLayout>
                            </Border>
                            <Border Grid.Column="2" Background="{StaticResource ObSurfaceElevated}" StrokeThickness="0"
                                    StrokeShape="RoundRectangle 12" Padding="8,12">
                                <VerticalStackLayout Spacing="4" HorizontalOptions="Center">
                                    <Label Text="BF ESTIMADO" FontFamily="JetBrainsMonoMedium" FontSize="9"
                                           TextColor="{StaticResource ObOnSurfaceSubtle}" HorizontalOptions="Center" />
                                    <Label Text="{Binding BfEstimadoLabel}" FontFamily="JetBrainsMonoSemiBold" FontSize="15" HorizontalOptions="Center" />
                                </VerticalStackLayout>
                            </Border>
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <!-- 5. RODAPÉ -->
                <VerticalStackLayout Spacing="2" Margin="0,4,0,0">
                    <Label Text="{Binding VersaoLabel}" FontFamily="JetBrainsMonoRegular" FontSize="10"
                           TextColor="{StaticResource ObOnSurfaceSubtle}" HorizontalOptions="Center" HorizontalTextAlignment="Center" />
                    <Label Text="Nenhum dado sai deste aparelho. Zero trackers." Style="{StaticResource ObLabelSubtle}" FontSize="10"
                           HorizontalOptions="Center" HorizontalTextAlignment="Center" />
                </VerticalStackLayout>

            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
