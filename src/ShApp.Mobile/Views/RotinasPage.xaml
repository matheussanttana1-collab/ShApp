<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:ShApp.Mobile.ViewModels"
             xmlns:items="clr-namespace:ShApp.Mobile.ViewModels.Items"
             x:Class="ShApp.Mobile.Views.RotinasPage"
             x:DataType="vm:RotinasViewModel"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{StaticResource ObBackground}">

    <Grid RowDefinitions="Auto,*">

        <!-- ===================== HEADER ===================== -->
        <Grid Grid.Row="0" Padding="20,14" ColumnDefinitions="*,Auto" BackgroundColor="{StaticResource ObBackground}">
            <HorizontalStackLayout Grid.Column="0" Spacing="10" VerticalOptions="Center">
                <Border WidthRequest="28" HeightRequest="28"
                        Background="{StaticResource ObSurfaceElevated}"
                        Stroke="{StaticResource ObBorderBrush}" StrokeThickness="1"
                        StrokeShape="RoundRectangle 8" Padding="0">
                    <Label Text="&#xeb43;" Style="{StaticResource ObIcon}" FontSize="15"
                           TextColor="{StaticResource ObPrimary}"
                           HorizontalOptions="Center" VerticalOptions="Center" />
                </Border>
                <Label Text="SHAPP" FontFamily="GeistSemiBold" FontSize="15"
                       CharacterSpacing="1.5" TextColor="{StaticResource ObOnSurface}" VerticalOptions="Center" />
            </HorizontalStackLayout>

            <HorizontalStackLayout Grid.Column="1" Spacing="8" VerticalOptions="Center">
                <Border Style="{StaticResource ObPill}">
                    <HorizontalStackLayout Spacing="5" VerticalOptions="Center">
                        <Ellipse WidthRequest="6" HeightRequest="6" Fill="{StaticResource ObTertiary}" VerticalOptions="Center" />
                        <Label Text="LOCAL" Style="{StaticResource ObMono}" FontSize="10" />
                    </HorizontalStackLayout>
                </Border>
                <Border WidthRequest="30" HeightRequest="30"
                        Background="{StaticResource ObSurfaceElevated}"
                        Stroke="{StaticResource ObBorderBrush}" StrokeThickness="1"
                        StrokeShape="RoundRectangle 15" Padding="0">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnPerfilIconTapped" />
                    </Border.GestureRecognizers>
                    <Label Text="&#xf0d3;" Style="{StaticResource ObIcon}" FontSize="15"
                           HorizontalOptions="Center" VerticalOptions="Center" />
                </Border>
            </HorizontalStackLayout>
        </Grid>

        <!-- ===================== EMPTY STATE ===================== -->
        <VerticalStackLayout Grid.Row="1" IsVisible="{Binding IsEmptyState}"
                              VerticalOptions="Center" HorizontalOptions="Center" Spacing="10" Padding="30">
            <Label Text="&#xefe8;" FontFamily="MaterialSymbolsOutlined" FontSize="36"
                   TextColor="{StaticResource ObOnSurfaceSubtle}" HorizontalOptions="Center" />
            <Label Text="{Binding EmptyStateMessage}" Style="{StaticResource ObTitleMd}" HorizontalOptions="Center"
                   HorizontalTextAlignment="Center" />
            <Label Text="Crie uma rotina para começar a treinar." Style="{StaticResource ObLabelMuted}"
                   HorizontalOptions="Center" HorizontalTextAlignment="Center" />
            <Button Text="+ Criar Rotina" Style="{StaticResource ObPrimaryButton}" Margin="0,10,0,0"
                    Command="{Binding AbrirCriarRotinaCommand}" />
        </VerticalStackLayout>

        <!-- ===================== CONTENT ===================== -->
        <ScrollView Grid.Row="1" IsVisible="{Binding HasRotina}">
            <VerticalStackLayout Padding="16,4,16,28" Spacing="16">

                <!-- TOP BAR -->
                <Grid ColumnDefinitions="*,Auto">
                    <VerticalStackLayout Grid.Column="0" Spacing="3">
                        <HorizontalStackLayout Spacing="8">
                            <Label Text="Rotinas" Style="{StaticResource ObTitleMd}" />
                            <Border Background="{StaticResource ObSurfaceCardBrush}"
                                    Stroke="{StaticResource ObTertiary}" StrokeThickness="1" Opacity="0.9"
                                    StrokeShape="RoundRectangle 4" Padding="6,2" VerticalOptions="Center">
                                <Label Text="ATIVO" FontFamily="JetBrainsMonoMedium" FontSize="9"
                                       TextColor="{StaticResource ObTertiary}" />
                            </Border>
                        </HorizontalStackLayout>
                        <Label Text="{Binding PlanoResumoTopo}" Style="{StaticResource ObMono}" FontSize="11" />
                    </VerticalStackLayout>

                    <HorizontalStackLayout Grid.Column="1" Spacing="6" VerticalOptions="Start">
                        <Border WidthRequest="30" HeightRequest="30"
                                Background="{StaticResource ObSurfaceCardBrush}"
                                Stroke="{StaticResource ObBorderBrush}" StrokeThickness="1"
                                StrokeShape="RoundRectangle 8" Padding="0">
                            <Label Text="&#xf097;" Style="{StaticResource ObIcon}" FontSize="14"
                                   HorizontalOptions="Center" VerticalOptions="Center" />
                        </Border>
                        <Border Background="{StaticResource ObPrimaryBrush}" StrokeShape="RoundRectangle 8"
                                Padding="9,0" HeightRequest="30">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding AbrirCriarRotinaCommand}" />
                            </Border.GestureRecognizers>
                            <HorizontalStackLayout Spacing="3" VerticalOptions="Center">
                                <Label Text="&#xe145;" FontFamily="MaterialSymbolsOutlined" FontSize="13"
                                       TextColor="{StaticResource ObOnPrimary}" VerticalOptions="Center" />
                                <Label Text="Nova" FontFamily="JetBrainsMonoMedium" FontSize="11"
                                       TextColor="{StaticResource ObOnPrimary}" VerticalOptions="Center" />
                            </HorizontalStackLayout>
                        </Border>
                    </HorizontalStackLayout>
                </Grid>

                <!-- CARD DO PLANO ATIVO -->
                <Border Style="{StaticResource ObCard}" Padding="16,14">
                    <VerticalStackLayout Spacing="10">
                        <Grid ColumnDefinitions="*,Auto">
                            <HorizontalStackLayout Grid.Column="0" Spacing="5" VerticalOptions="Center">
                                <Ellipse WidthRequest="6" HeightRequest="6" Fill="{StaticResource ObTertiary}" VerticalOptions="Center" />
                                <Label Text="ATIVA" FontFamily="JetBrainsMonoMedium" FontSize="10"
                                       TextColor="{StaticResource ObTertiary}" CharacterSpacing="0.5" />
                            </HorizontalStackLayout>
                            <Label Grid.Column="1" Text="{Binding DataInicioLabel}" Style="{StaticResource ObMono}" FontSize="10" />
                        </Grid>

                        <VerticalStackLayout Spacing="3">
                            <Label Text="{Binding NomeDoPlano}" FontFamily="GeistSemiBold" FontSize="15" />
                            <Label Text="{Binding DescricaoDoPlano}"
                                   Style="{StaticResource ObMono}" FontSize="12" />
                        </VerticalStackLayout>

                        <BoxView HeightRequest="1" Color="{StaticResource ObBorder}" Opacity="0.5" />

                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                            <Border Grid.Column="0" Background="{StaticResource ObSurfaceElevated}"
                                    Stroke="{StaticResource ObBorderBrush}" StrokeThickness="1"
                                    StrokeShape="RoundRectangle 8" Padding="10,7">
                                <HorizontalStackLayout Spacing="8">
                                    <Border WidthRequest="20" HeightRequest="20"
                                            Background="{StaticResource ObPrimarySoft}" StrokeShape="RoundRectangle 5"
                                            Padding="0">
                                        <Label Text="&#xe037;" FontFamily="MaterialSymbolsOutlined" FontSize="12"
                                               TextColor="{StaticResource ObPrimary}"
                                               HorizontalOptions="Center" VerticalOptions="Center" />
                                    </Border>
                                    <VerticalStackLayout Spacing="1">
                                        <Label Text="PRÓXIMA SESSÃO" FontFamily="JetBrainsMonoSemiBold" FontSize="9"
                                               TextColor="{StaticResource ObPrimary}" CharacterSpacing="0.6" />
                                        <Label Text="{Binding ProximaSessaoResumo}" FontFamily="GeistMedium" FontSize="11" />
                                    </VerticalStackLayout>
                                </HorizontalStackLayout>
                            </Border>
                            <Border Grid.Column="1" Background="{StaticResource ObSurfaceElevated}" Opacity="0.8"
                                    Stroke="{StaticResource ObBorderBrush}" StrokeThickness="1"
                                    StrokeShape="RoundRectangle 8" Padding="10,0" VerticalOptions="Center" HeightRequest="38">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding AbrirEditarRotinaCommand}" />
                                </Border.GestureRecognizers>
                                <Label Text="Editar" Style="{StaticResource ObMono}" FontSize="11"
                                       VerticalOptions="Center" />
                            </Border>
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <!-- CICLO SEMANAL -->
                <VerticalStackLayout Spacing="8">
                    <Grid ColumnDefinitions="*,Auto">
                        <HorizontalStackLayout Grid.Column="0" Spacing="5" VerticalOptions="Center">
                            <Label Text="&#xe935;" FontFamily="MaterialSymbolsOutlined" FontSize="13"
                                   TextColor="{StaticResource ObPrimary}" />
                            <Label Text="CICLO SEMANAL" Style="{StaticResource ObEyebrow}" />
                        </HorizontalStackLayout>
                        <HorizontalStackLayout Grid.Column="1" Spacing="3">
                            <Label Text="Hoje:" Style="{StaticResource ObMono}" FontSize="11" />
                            <Label Text="{Binding HojeResumoLabel}" FontFamily="JetBrainsMonoSemiBold" FontSize="11"
                                   TextColor="{StaticResource ObPrimary}" />
                        </HorizontalStackLayout>
                    </Grid>

                    <Grid ColumnDefinitions="*,*,*,*,*,*,*" ColumnSpacing="4"
                          BindableLayout.ItemsSource="{Binding CicloSemanal}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="items:CicloSemanalDiaViewModel">
                                <Border Grid.Column="{Binding ColumnIndex}"
                                        Background="{StaticResource ObSurfaceCardBrush}"
                                        Stroke="{StaticResource ObBorderBrush}" StrokeThickness="1"
                                        StrokeShape="RoundRectangle 10" Padding="2,10">
                                    <Border.Triggers>
                                        <DataTrigger TargetType="Border" Binding="{Binding IsDiaDeTreino}" Value="False">
                                            <Setter Property="Stroke" Value="{StaticResource ObBorderSubtle}" />
                                            <Setter Property="Opacity" Value="0.5" />
                                        </DataTrigger>
                                        <DataTrigger TargetType="Border" Binding="{Binding IsHoje}" Value="True">
                                            <Setter Property="Background" Value="{StaticResource ObPrimarySoft}" />
                                            <Setter Property="Stroke" Value="{StaticResource ObPrimaryBrush}" />
                                            <Setter Property="StrokeThickness" Value="1.2" />
                                            <Setter Property="Opacity" Value="1" />
                                        </DataTrigger>
                                    </Border.Triggers>
                                    <VerticalStackLayout Spacing="3" HorizontalOptions="Center">
                                        <Label Text="{Binding Abreviacao}" FontFamily="JetBrainsMonoMedium" FontSize="9"
                                               TextColor="{StaticResource ObOnSurfaceMuted}" HorizontalOptions="Center">
                                            <Label.Triggers>
                                                <DataTrigger TargetType="Label" Binding="{Binding IsHoje}" Value="True">
                                                    <Setter Property="TextColor" Value="{StaticResource ObPrimary}" />
                                                    <Setter Property="FontFamily" Value="JetBrainsMonoSemiBold" />
                                                </DataTrigger>
                                            </Label.Triggers>
                                        </Label>
                                        <Label Text="{Binding LetraOuOff}" FontFamily="JetBrainsMonoSemiBold" FontSize="12"
                                               HorizontalOptions="Center">
                                            <Label.Triggers>
                                                <DataTrigger TargetType="Label" Binding="{Binding IsDiaDeTreino}" Value="False">
                                                    <Setter Property="FontFamily" Value="JetBrainsMonoRegular" />
                                                    <Setter Property="FontSize" Value="9" />
                                                    <Setter Property="TextColor" Value="{StaticResource ObOnSurfaceMuted}" />
                                                </DataTrigger>
                                                <DataTrigger TargetType="Label" Binding="{Binding IsHoje}" Value="True">
                                                    <Setter Property="TextColor" Value="{StaticResource ObPrimary}" />
                                                </DataTrigger>
                                            </Label.Triggers>
                                        </Label>
                                        <Ellipse WidthRequest="5" HeightRequest="5" Fill="{StaticResource ObPrimaryBrush}"
                                                 HorizontalOptions="Center" IsVisible="{Binding IsHoje}" />
                                    </VerticalStackLayout>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </Grid>

                    <Grid ColumnDefinitions="*,Auto">
                        <HorizontalStackLayout Grid.Column="0" Spacing="4">
                            <Label Text="&#xe040;" FontFamily="MaterialSymbolsOutlined" FontSize="12"
                                   TextColor="{StaticResource ObPrimary}" />
                            <Label Text="Ciclo contínuo: sem reinício semanal fixo"
                                   Style="{StaticResource ObMono}" FontSize="10" />
                        </HorizontalStackLayout>
                        <Label Grid.Column="1" Text="{Binding PassoAtualLabel}" FontFamily="JetBrainsMonoMedium" FontSize="10"
                               TextColor="{StaticResource ObPrimary}" />
                    </Grid>
                </VerticalStackLayout>

                <!-- ESTRUTURA DA DIVISÃO -->
                <VerticalStackLayout Spacing="4">
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Grid.Column="0" Text="{Binding EstruturaHeaderLabel}" Style="{StaticResource ObEyebrow}"
                               VerticalOptions="Center" />
                        <Label Grid.Column="1" Text="{Binding EstruturaContagemLabel}" Style="{StaticResource ObMono}"
                               FontSize="10" VerticalOptions="Center" />
                    </Grid>

                    <BoxView HeightRequest="1" Color="{StaticResource ObBorder}" Opacity="0.6" Margin="0,6,0,0" />

                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding DiasDaDivisao}" Spacing="0">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="items:DiaRotinaCardViewModel">
                                <VerticalStackLayout Spacing="0">
                                    <Border Padding="10" StrokeThickness="0" StrokeShape="RoundRectangle 0"
                                            Background="Transparent">
                                        <Border.Triggers>
                                            <DataTrigger TargetType="Border" Binding="{Binding IsToday}" Value="True">
                                                <Setter Property="Background" Value="{StaticResource ObSurfaceSunken}" />
                                            </DataTrigger>
                                        </Border.Triggers>
                                        <VerticalStackLayout Spacing="0">
                                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                                                <Grid.GestureRecognizers>
                                                    <TapGestureRecognizer Command="{Binding ToggleExpandCommand}" />
                                                </Grid.GestureRecognizers>
                                                <Border Grid.Column="0" WidthRequest="22" HeightRequest="22"
                                                        Background="{StaticResource ObSurfaceElevated}"
                                                        Stroke="{StaticResource ObBorderBrush}" StrokeThickness="1"
                                                        StrokeShape="RoundRectangle 6" Padding="0">
                                                    <Border.Triggers>
                                                        <DataTrigger TargetType="Border" Binding="{Binding IsToday}" Value="True">
                                                            <Setter Property="Background" Value="{StaticResource ObPrimaryBrush}" />
                                                            <Setter Property="StrokeThickness" Value="0" />
                                                        </DataTrigger>
                                                    </Border.Triggers>
                                                    <Label Text="{Binding Letra}" FontFamily="JetBrainsMonoSemiBold" FontSize="11"
                                                           HorizontalOptions="Center" VerticalOptions="Center">
                                                        <Label.Triggers>
                                                            <DataTrigger TargetType="Label" Binding="{Binding IsToday}" Value="True">
                                                                <Setter Property="TextColor" Value="{StaticResource ObOnPrimary}" />
                                                            </DataTrigger>
                                                        </Label.Triggers>
                                                    </Label>
                                                </Border>
                                                <VerticalStackLayout Grid.Column="1" Spacing="1">
                                                    <HorizontalStackLayout Spacing="6">
                                                        <Label Text="{Binding NomeGrupos}" FontFamily="GeistMedium" FontSize="13" />
                                                        <Label Text="{Binding ContagemLabel}" Style="{StaticResource ObMono}" FontSize="10" />
                                                        <Border Background="{StaticResource ObPrimarySoft}" StrokeShape="RoundRectangle 4"
                                                                Padding="5,1" IsVisible="{Binding IsToday}">
                                                            <Label Text="HOJE" FontFamily="JetBrainsMonoSemiBold" FontSize="9"
                                                                   TextColor="{StaticResource ObPrimary}" />
                                                        </Border>
                                                    </HorizontalStackLayout>
                                                    <Label Text="{Binding ResumoExerciciosCurto}"
                                                           Style="{StaticResource ObMono}" FontSize="11"
                                                           LineBreakMode="TailTruncation" />
                                                </VerticalStackLayout>
                                                <Label Grid.Column="2" Text="&#xe5cf;"
                                                       FontFamily="MaterialSymbolsOutlined" FontSize="16"
                                                       TextColor="{StaticResource ObOnSurfaceMuted}" VerticalOptions="Center">
                                                    <Label.Triggers>
                                                        <DataTrigger TargetType="Label" Binding="{Binding IsExpanded}" Value="True">
                                                            <Setter Property="Rotation" Value="180" />
                                                        </DataTrigger>
                                                        <DataTrigger TargetType="Label" Binding="{Binding IsToday}" Value="True">
                                                            <Setter Property="TextColor" Value="{StaticResource ObPrimary}" />
                                                        </DataTrigger>
                                                    </Label.Triggers>
                                                </Label>
                                            </Grid>

                                            <VerticalStackLayout IsVisible="{Binding IsExpanded}" Spacing="0"
                                                                  Padding="32,8,0,0"
                                                                  BindableLayout.ItemsSource="{Binding Exercicios}">
                                                <BindableLayout.ItemTemplate>
                                                    <DataTemplate x:DataType="items:ExercicioRowViewModel">
                                                        <VerticalStackLayout Spacing="0">
                                                            <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="8" Padding="0,5">
                                                                <Label Grid.Column="0" Text="{Binding NumeroLabel}" FontFamily="JetBrainsMonoRegular"
                                                                       FontSize="10" TextColor="{StaticResource ObPrimary}" WidthRequest="16" />
                                                                <Label Grid.Column="1" Text="{Binding NomeExercicio}" FontFamily="GeistMedium" FontSize="11" />
                                                                <Label Grid.Column="2" Text="{Binding SeriesRepeticoesLabel}" Style="{StaticResource ObMono}" FontSize="11" />
                                                                <Border Grid.Column="3" Background="{StaticResource ObSurfaceElevated}"
                                                                        StrokeShape="RoundRectangle 4" Padding="5,2">
                                                                    <Label Text="{Binding PesoLabel}" FontFamily="JetBrainsMonoRegular" FontSize="10" />
                                                                </Border>
                                                            </Grid>
                                                            <BoxView HeightRequest="1" Color="{StaticResource ObBorder}" Opacity="0.3" />
                                                        </VerticalStackLayout>
                                                    </DataTemplate>
                                                </BindableLayout.ItemTemplate>
                                            </VerticalStackLayout>
                                        </VerticalStackLayout>
                                    </Border>
                                    <BoxView HeightRequest="1" Color="{StaticResource ObBorder}" Opacity="0.4" />
                                </VerticalStackLayout>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>

                    <!-- RODAPÉ INFORMATIVO -->
                    <Grid ColumnDefinitions="*,Auto" Padding="0,6,0,0">
                        <HorizontalStackLayout Grid.Column="0" Spacing="4">
                            <Label Text="&#xea18;" FontFamily="MaterialSymbolsOutlined" FontSize="12"
                                   TextColor="{StaticResource ObPrimary}" />
                            <Label Text="Fluxo contínuo sem reinício" Style="{StaticResource ObMono}" FontSize="10" />
                        </HorizontalStackLayout>
                        <Label Grid.Column="1" Text="{Binding RodapeCicloLabel}" Style="{StaticResource ObMono}" FontSize="10" />
                    </Grid>

                    <!-- AÇÕES -->
                    <Button Text="{Binding IniciarSessaoLabel}" Style="{StaticResource ObPrimaryButton}"
                            BackgroundColor="{StaticResource ObPrimaryBrush}" TextColor="{StaticResource ObOnPrimary}"
                            CornerRadius="24" Margin="0,8,0,0" />

                    <HorizontalStackLayout Spacing="14" HorizontalOptions="Center" Margin="0,4,0,0">
                        <HorizontalStackLayout Spacing="4">
                            <HorizontalStackLayout.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding AbrirCriarRotinaCommand}" />
                            </HorizontalStackLayout.GestureRecognizers>
                            <Label Text="&#xe145;" FontFamily="MaterialSymbolsOutlined" FontSize="12"
                                   TextColor="{StaticResource ObOnSurfaceMuted}" />
                            <Label Text="Criar Nova Rotina" Style="{StaticResource ObMono}" FontSize="11" />
                        </HorizontalStackLayout>
                        <Label Text="•" Style="{StaticResource ObLabelSubtle}" />
                        <HorizontalStackLayout Spacing="4">
                            <Label Text="&#xe8b3;" FontFamily="MaterialSymbolsOutlined" FontSize="12"
                                   TextColor="{StaticResource ObOnSurfaceMuted}" />
                            <Label Text="Histórico" Style="{StaticResource ObMono}" FontSize="11" />
                        </HorizontalStackLayout>
                    </HorizontalStackLayout>
                </VerticalStackLayout>

            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
