<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:ShApp.Mobile.ViewModels"
             xmlns:items="clr-namespace:ShApp.Mobile.ViewModels.Items"
             x:Class="ShApp.Mobile.Views.SessaoDeTreinoPage"
             x:DataType="vm:SessaoDeTreinoViewModel"
             Shell.TabBarIsVisible="False"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{StaticResource ObBackground}">

    <Grid RowDefinitions="Auto,*,Auto">

        <!-- ===================== HEADER ===================== -->
        <Grid Grid.Row="0" Padding="20,14" ColumnDefinitions="*,Auto" BackgroundColor="{StaticResource ObBackground}">
            <VerticalStackLayout Grid.Column="0" Spacing="1" VerticalOptions="Center">
                <Label Text="SESSÃO DE TREINO" Style="{StaticResource ObEyebrow}" />
                <Label Text="{Binding ExercicioAtual.OrdemLabel}" FontFamily="GeistSemiBold" FontSize="15"
                       LineBreakMode="TailTruncation" />
            </VerticalStackLayout>

            <Border Grid.Column="1" Style="{StaticResource ObPill}" VerticalOptions="Center">
                <HorizontalStackLayout Spacing="5" VerticalOptions="Center">
                    <Ellipse WidthRequest="6" HeightRequest="6" Fill="{StaticResource ObOnSurfaceSubtle}" VerticalOptions="Center" />
                    <Label Text="OFFLINE" Style="{StaticResource ObMono}" FontSize="10" />
                </HorizontalStackLayout>
            </Border>
        </Grid>

        <!-- ===================== EMPTY STATE ===================== -->
        <VerticalStackLayout Grid.Row="1" IsVisible="{Binding IsEmptyState}"
                              VerticalOptions="Center" HorizontalOptions="Center" Spacing="10" Padding="30">
            <Label Text="&#xeb43;" FontFamily="MaterialSymbolsOutlined" FontSize="36"
                   TextColor="{StaticResource ObOnSurfaceSubtle}" HorizontalOptions="Center" />
            <Label Text="{Binding EmptyStateMensagem}" Style="{StaticResource ObTitleMd}" HorizontalOptions="Center"
                   HorizontalTextAlignment="Center" />
            <Label Text="Confira sua rotina ativa para liberar o treino de hoje." Style="{StaticResource ObLabelMuted}"
                   HorizontalOptions="Center" HorizontalTextAlignment="Center" />
            <Button Text="&#8592;  Voltar" Style="{StaticResource ObSecondaryButton}" Margin="0,10,0,0"
                    Command="{Binding VoltarCommand}" />
        </VerticalStackLayout>

        <!-- ===================== CONTEÚDO ===================== -->
        <ScrollView Grid.Row="1" IsVisible="{Binding HasTreino}">
            <VerticalStackLayout Padding="16,6,16,24" Spacing="16">

                <!-- EXERCÍCIO ATUAL -->
                <Border Style="{StaticResource ObCard}">
                    <VerticalStackLayout Spacing="4">
                        <Label Text="{Binding ExercicioAtual.GrupoMuscularLabel}" Style="{StaticResource ObEyebrow}" />
                        <Label Text="{Binding ExercicioAtual.NomeExercicio}" Style="{StaticResource ObTitleLg}"
                               LineBreakMode="TailTruncation" />
                    </VerticalStackLayout>
                </Border>

                <!-- DESCANSO -->
                <Border Style="{StaticResource ObCard}" IsVisible="{Binding IsDescansoAtivo}">
                    <VerticalStackLayout Spacing="10" HorizontalOptions="Center">
                        <Label Text="DESCANSO" Style="{StaticResource ObEyebrow}" HorizontalOptions="Center" />
                        <Label Text="{Binding DescansoLabel}" FontFamily="JetBrainsMonoSemiBold" FontSize="32"
                               TextColor="{StaticResource ObPrimary}" HorizontalOptions="Center" />
                        <ProgressBar Progress="{Binding DescansoProgresso}" ProgressColor="{StaticResource ObPrimary}"
                                     HeightRequest="5" WidthRequest="220" />
                    </VerticalStackLayout>
                </Border>

                <!-- ERRO DE VALIDAÇÃO -->
                <Label Text="{Binding ErroSerieLabel}" TextColor="{StaticResource ObError}" FontSize="12"
                       IsVisible="{Binding HasErro}" HorizontalTextAlignment="Center" HorizontalOptions="Center" />

                <!-- SÉRIES DO EXERCÍCIO ATUAL -->
                <VerticalStackLayout Spacing="8" BindableLayout.ItemsSource="{Binding ExercicioAtual.Series}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="items:SerieExecucaoViewModel">
                            <Border Background="{StaticResource ObSurfaceCardBrush}" StrokeShape="RoundRectangle 12" Padding="14,12">
                                <Border.Triggers>
                                    <DataTrigger TargetType="Border" Binding="{Binding IsAtual}" Value="True">
                                        <Setter Property="Stroke" Value="{StaticResource ObPrimaryBrush}" />
                                        <Setter Property="StrokeThickness" Value="1.5" />
                                        <Setter Property="Opacity" Value="1" />
                                    </DataTrigger>
                                    <DataTrigger TargetType="Border" Binding="{Binding IsConcluida}" Value="True">
                                        <Setter Property="Stroke" Value="{StaticResource ObBorderBrush}" />
                                        <Setter Property="StrokeThickness" Value="1" />
                                        <Setter Property="Opacity" Value="0.75" />
                                    </DataTrigger>
                                    <DataTrigger TargetType="Border" Binding="{Binding IsFutura}" Value="True">
                                        <Setter Property="Stroke" Value="{StaticResource ObBorderSubtle}" />
                                        <Setter Property="StrokeThickness" Value="1" />
                                        <Setter Property="Opacity" Value="0.5" />
                                    </DataTrigger>
                                </Border.Triggers>

                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                                    <Border Grid.Column="0" WidthRequest="26" HeightRequest="26"
                                            Background="{StaticResource ObSurfaceElevated}" StrokeShape="RoundRectangle 13" Padding="0">
                                        <Label Text="{Binding Numero}" FontFamily="JetBrainsMonoSemiBold" FontSize="12"
                                               TextColor="{StaticResource ObOnSurfaceMuted}"
                                               HorizontalOptions="Center" VerticalOptions="Center" />
                                    </Border>

                                    <!-- Concluída: travada, mostra o que foi registrado -->
                                    <HorizontalStackLayout Grid.Column="1" Spacing="8" VerticalOptions="Center"
                                                            IsVisible="{Binding IsConcluida}">
                                        <Label FontFamily="JetBrainsMonoMedium" FontSize="13" TextColor="{StaticResource ObTertiary}">
                                            <Label.FormattedText>
                                                <FormattedString>
                                                    <Span Text="{Binding RepeticoesFeitas}" />
                                                    <Span Text=" reps × " />
                                                    <Span Text="{Binding PesoUsado, StringFormat='{0:0.#}'}" />
                                                    <Span Text=" kg" />
                                                </FormattedString>
                                            </Label.FormattedText>
                                        </Label>
                                        <Label Text="concluída" Style="{StaticResource ObLabelSubtle}" VerticalOptions="Center" />
                                    </HorizontalStackLayout>

                                    <!-- Atual: única linha editável -->
                                    <Grid Grid.Column="1" ColumnDefinitions="Auto,Auto,Auto,Auto" ColumnSpacing="6"
                                          IsVisible="{Binding IsAtual}" VerticalOptions="Center">
                                        <Entry Grid.Column="0" Text="{Binding RepeticoesFeitas}" Keyboard="Numeric" WidthRequest="46"
                                               FontSize="13" HorizontalTextAlignment="Center"
                                               SemanticProperties.Hint="Repetições feitas nesta série" />
                                        <Label Grid.Column="1" Text="reps ×" Style="{StaticResource ObLabelMuted}" FontSize="12"
                                               VerticalOptions="Center" />
                                        <Entry Grid.Column="2" Text="{Binding PesoUsado}" Keyboard="Numeric" WidthRequest="56"
                                               FontSize="13" HorizontalTextAlignment="Center"
                                               SemanticProperties.Hint="Peso usado nesta série, em quilos" />
                                        <Label Grid.Column="3" Text="kg" Style="{StaticResource ObLabelMuted}" FontSize="12"
                                               VerticalOptions="Center" />
                                    </Grid>

                                    <!-- Futura: esmaecida, só mostra a meta -->
                                    <Label Grid.Column="1" Style="{StaticResource ObLabelMuted}" FontSize="12" VerticalOptions="Center"
                                           IsVisible="{Binding IsFutura}">
                                        <Label.FormattedText>
                                            <FormattedString>
                                                <Span Text="Meta: " />
                                                <Span Text="{Binding RepeticoesMeta}" />
                                                <Span Text=" reps" />
                                            </FormattedString>
                                        </Label.FormattedText>
                                    </Label>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>

            </VerticalStackLayout>
        </ScrollView>

        <!-- ===================== RODAPÉ ===================== -->
        <VerticalStackLayout Grid.Row="2" Padding="16,12" Spacing="8"
                              BackgroundColor="{StaticResource ObBackground}" IsVisible="{Binding HasTreino}">
            <Button Text="{Binding BotaoPrincipalLabel}" Style="{StaticResource ObPrimaryButton}"
                    Command="{Binding AcaoPrincipalCommand}" />
            <Button Text="Encerrar Treino" Style="{StaticResource ObSecondaryButton}"
                    Command="{Binding EncerrarTreinoCommand}" />
        </VerticalStackLayout>
    </Grid>
</ContentPage>
